<view class="study-container">
  <!-- 顶部栏 -->
  <view class="study-header">
    <view class="header-left" bindtap="goBackPage">
      <text class="back-icon">←</text>
      <text class="library-name">{{library.name}}</text>
    </view>
    <text class="study-count">第 {{studyCount + 1}} 张</text>
  </view>

  <!-- 完成状态 -->
  <view class="complete-view" wx:if="{{isComplete}}">
    <view class="complete-icon">🎉</view>
    <text class="complete-title">本轮学习完成！</text>
    <text class="complete-subtitle">你已完成本轮学习目标</text>
    
    <view class="complete-stats">
      <view class="stat-item">
        <text class="stat-num">{{sessionStats.studied}}</text>
        <text class="stat-label">学习单词</text>
      </view>
      <view class="stat-item">
        <text class="stat-num text-success">{{sessionStats.mastered}}</text>
        <text class="stat-label">新掌握</text>
      </view>
    </view>

    <view class="complete-actions">
      <button class="btn-primary" bindtap="continueStudy">继续学习</button>
      <button class="btn-outline" bindtap="goHome">返回词库</button>
    </view>
  </view>

  <!-- 学习界面 -->
  <view class="study-content" wx:else>
    <!-- 回退提示 -->
    <view class="reviewing-tip" wx:if="{{isReviewing}}">
      <text>正在回顾上一个单词，请重新选择掌握程度</text>
    </view>

    <!-- 闪卡 -->
    <view class="flashcard-container" bindtap="flipCard">
      <view class="flashcard {{isFlipped ? 'flipped' : ''}} {{isAnimating ? 'animating' : ''}}">
        <!-- 正面 -->
        <view class="card-face card-front">
          <text class="word-text">{{currentWord.word}}</text>
          <text class="word-phonetic" wx:if="{{currentWord.phonetic}}">{{currentWord.phonetic}}</text>
          <view class="frequency-tag" wx:if="{{currentWord.frequencyRank && currentWord.frequencyRank < 99999}}">
            <text>词频排名 #{{currentWord.frequencyRank}}</text>
          </view>
          <view class="speak-btn" catchtap="speakWord">
            <text>🔊</text>
          </view>
          <text class="flip-hint">点击翻转查看释义</text>
        </view>

        <!-- 背面 -->
        <view class="card-face card-back">
          <view class="back-header">
            <view>
              <text class="back-word">{{currentWord.word}}</text>
              <view class="frequency-tag small" wx:if="{{currentWord.frequencyRank && currentWord.frequencyRank < 99999}}">
                <text>#{{currentWord.frequencyRank}}</text>
              </view>
            </view>
            <view class="speak-btn small" catchtap="speakWord">
              <text>🔊</text>
            </view>
          </view>

          <!-- 释义 -->
          <view class="definitions" wx:if="{{currentWord.definitions.length > 0}}">
            <text class="section-label">释义</text>
            <view class="def-item" wx:for="{{currentWord.definitions}}" wx:key="index">
              <text class="def-pos" wx:if="{{item.pos}}">{{item.pos}}</text>
              <text class="def-meaning">{{item.meaning}}</text>
            </view>
          </view>

          <!-- 短语 -->
          <view class="phrases" wx:if="{{currentWord.phrases.length > 0}}">
            <text class="section-label">常见搭配</text>
            <view class="phrase-item" wx:for="{{currentWord.phrases}}" wx:key="index">
              <text class="phrase-text">{{item.phrase}}</text>
              <text class="phrase-meaning">{{item.meaning}}</text>
            </view>
          </view>

          <!-- 例句 -->
          <view class="examples" wx:if="{{currentWord.examples.length > 0}}">
            <text class="section-label">例句</text>
            <view class="example-item" wx:for="{{currentWord.examples}}" wx:key="index">
              <text class="example-sentence">"{{item.sentence}}"</text>
              <text class="example-translation" wx:if="{{item.translation}}">{{item.translation}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作区 -->
    <view class="study-actions">
      <!-- 已翻转：显示反馈按钮 -->
      <view class="feedback-buttons" wx:if="{{isFlipped}}">
        <view class="feedback-btn unknown" bindtap="submitFeedback" data-feedback="unknown">
          <text class="btn-icon">❌</text>
          <text class="btn-label">不认识</text>
        </view>
        <view class="feedback-btn familiar" bindtap="submitFeedback" data-feedback="familiar">
          <text class="btn-icon">🤔</text>
          <text class="btn-label">有点印象</text>
        </view>
        <view class="feedback-btn well-known" bindtap="submitFeedback" data-feedback="well_known">
          <text class="btn-icon">🧠</text>
          <text class="btn-label">快记住了</text>
        </view>
        <view class="feedback-btn mastered" bindtap="submitFeedback" data-feedback="mastered">
          <text class="btn-icon">✅</text>
          <text class="btn-label">已掌握</text>
        </view>
      </view>

      <!-- 未翻转：显示查看答案按钮 -->
      <view class="view-answer" wx:else>
        <button class="btn-outline btn-large" bindtap="flipCard">👁 查看答案</button>
        <button class="btn-success btn-large" bindtap="markAsMastered">✅ 已掌握</button>
      </view>
    </view>

    <!-- 底部统计 -->
    <view class="session-stats" wx:if="{{sessionStats.studied > 0}}">
      <text>本轮已学: {{sessionStats.studied}}</text>
      <text>新掌握: {{sessionStats.mastered}}</text>
      <text wx:if="{{history.length > 0}}" class="go-back" bindtap="goBack">
        ↩ 上一个
      </text>
    </view>
  </view>
</view>
