/* 学习页面样式 */
.study-container {
  min-height: 100vh;
  background: #f3f4f6;
  display: flex;
  flex-direction: column;
}

/* 顶部栏 */
.study-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: white;
  border-bottom: 1px solid #e5e7eb;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.back-icon {
  font-size: 20px;
  color: #6b7280;
  padding: 4px;
}

.library-name {
  font-size: 15px;
  font-weight: 500;
  color: #1f2937;
}

.study-count {
  font-size: 12px;
  color: #9ca3af;
}

/* 完成状态 */
.complete-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.complete-icon {
  font-size: 64px;
  margin-bottom: 20px;
}

.complete-title {
  font-size: 22px;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8px;
}

.complete-subtitle {
  font-size: 14px;
  color: #9ca3af;
  margin-bottom: 32px;
}

.complete-stats {
  display: flex;
  gap: 40px;
  margin-bottom: 40px;
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 36px;
  font-weight: 600;
  color: #3b82f6;
  display: block;
}

.stat-num.text-success {
  color: #22c55e;
}

.complete-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  max-width: 280px;
}

.complete-actions button {
  width: 100%;
}

/* 学习内容 */
.study-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 16px;
}

.reviewing-tip {
  background: #fef3c7;
  border: 1px solid #fcd34d;
  border-radius: 8px;
  padding: 10px 16px;
  margin-bottom: 16px;
  text-align: center;
}

.reviewing-tip text {
  font-size: 13px;
  color: #92400e;
}

/* 闪卡容器 */
.flashcard-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1000px;
  margin-bottom: 20px;
}

.flashcard {
  width: 100%;
  max-width: 360px;
  height: 480px;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.flashcard.flipped {
  transform: rotateY(180deg);
}

.flashcard.animating {
  opacity: 0;
  transform: translateX(-100%);
}

.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 20px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.1);
  overflow: hidden;
}

/* 卡片正面 */
.card-front {
  background: linear-gradient(135deg, #1f2937, #374151);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.word-text {
  font-size: 42px;
  font-weight: 700;
  color: white;
  margin-bottom: 12px;
  text-align: center;
}

.word-phonetic {
  font-size: 18px;
  color: #9ca3af;
  margin-bottom: 20px;
}

.frequency-tag {
  background: rgba(255,255,255,0.1);
  padding: 6px 12px;
  border-radius: 16px;
  margin-bottom: 24px;
}

.frequency-tag text {
  font-size: 12px;
  color: #d1d5db;
}

.frequency-tag.small {
  display: inline-block;
  margin-bottom: 0;
  margin-left: 8px;
}

.speak-btn {
  width: 56px;
  height: 56px;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32px;
}

.speak-btn text {
  font-size: 24px;
}

.speak-btn.small {
  width: 40px;
  height: 40px;
}

.speak-btn.small text {
  font-size: 18px;
}

.flip-hint {
  font-size: 13px;
  color: #6b7280;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* 卡片背面 */
.card-back {
  background: white;
  transform: rotateY(180deg);
  padding: 24px;
  overflow-y: auto;
}

.back-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16px;
  border-bottom: 1px solid #e5e7eb;
  margin-bottom: 20px;
}

.back-word {
  font-size: 28px;
  font-weight: 600;
  color: #1f2937;
}

.section-label {
  font-size: 11px;
  font-weight: 600;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 12px;
  display: block;
}

/* 释义 */
.definitions {
  margin-bottom: 24px;
}

.def-item {
  margin-bottom: 8px;
}

.def-pos {
  font-size: 13px;
  color: #3b82f6;
  font-weight: 500;
  margin-right: 8px;
}

.def-meaning {
  font-size: 14px;
  color: #1f2937;
}

/* 短语 */
.phrases {
  margin-bottom: 24px;
}

.phrase-item {
  margin-bottom: 10px;
}

.phrase-text {
  font-size: 14px;
  font-weight: 500;
  color: #374151;
  display: block;
  margin-bottom: 2px;
}

.phrase-meaning {
  font-size: 13px;
  color: #6b7280;
}

/* 例句 */
.examples {
  margin-bottom: 16px;
}

.example-item {
  margin-bottom: 12px;
}

.example-sentence {
  font-size: 14px;
  color: #374151;
  font-style: italic;
  display: block;
  margin-bottom: 4px;
}

.example-translation {
  font-size: 13px;
  color: #9ca3af;
}

/* 操作区 */
.study-actions {
  margin-bottom: 16px;
}

/* 反馈按钮 */
.feedback-buttons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.feedback-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 8px;
  border-radius: 12px;
  transition: transform 0.2s;
}

.feedback-btn:active {
  transform: scale(0.95);
}

.feedback-btn.unknown {
  background: #fee2e2;
}

.feedback-btn.familiar {
  background: #dbeafe;
}

.feedback-btn.well-known {
  background: #fef3c7;
}

.feedback-btn.mastered {
  background: #dcfce7;
}

.btn-icon {
  font-size: 24px;
  margin-bottom: 6px;
}

.btn-label {
  font-size: 12px;
  color: #1f2937;
  font-weight: 500;
}

/* 查看答案 */
.view-answer {
  display: flex;
  gap: 12px;
}

.view-answer button {
  flex: 1;
}

.btn-large {
  padding: 16px;
  font-size: 15px;
}

.btn-success {
  background: #22c55e;
  color: white;
  border: none;
  border-radius: 8px;
}

.btn-success::after {
  border: none;
}

/* 会话统计 */
.session-stats {
  display: flex;
  justify-content: center;
  gap: 16px;
  padding: 12px;
  font-size: 12px;
  color: #9ca3af;
}

.go-back {
  color: #3b82f6;
  padding: 4px 8px;
  border-radius: 4px;
}

.go-back:active {
  background: #dbeafe;
}
