/* 个人中心样式 */
.container {
  padding: 16px;
  padding-bottom: 32px;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #1f2937, #374151);
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 20px;
  color: white;
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.stats-title {
  font-size: 18px;
  font-weight: 600;
}

.stats-subtitle {
  font-size: 12px;
  color: #9ca3af;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 16px;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 24px;
  font-weight: 600;
  color: white;
  display: block;
  margin-bottom: 4px;
}

.stat-value.text-success {
  color: #4ade80;
}

.stat-value.text-warning {
  color: #fbbf24;
}

.stat-label {
  font-size: 11px;
  color: #9ca3af;
}

.stats-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 16px;
  border-top: 1px solid rgba(255,255,255,0.1);
  font-size: 12px;
  color: #9ca3af;
}

/* 设置分区 */
.settings-section {
  margin-bottom: 16px;
}

.section-title {
  font-size: 13px;
  font-weight: 600;
  color: #9ca3af;
  margin-bottom: 8px;
  padding-left: 4px;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  padding: 14px 16px;
  margin-bottom: 1px;
}

.setting-item:first-of-type {
  border-radius: 12px 12px 0 0;
}

.setting-item:last-of-type {
  border-radius: 0 0 12px 12px;
  margin-bottom: 0;
}

.setting-item:only-of-type {
  border-radius: 12px;
}

.setting-item.danger {
  color: #ef4444;
}

.setting-item.danger .setting-name {
  color: #ef4444;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.setting-icon {
  font-size: 20px;
  width: 24px;
  text-align: center;
}

.setting-name {
  font-size: 15px;
  color: #1f2937;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.setting-value {
  font-size: 14px;
  color: #9ca3af;
}

.setting-status {
  font-size: 12px;
  color: #9ca3af;
  padding: 2px 8px;
  background: #f3f4f6;
  border-radius: 4px;
}

.setting-status.active {
  color: #22c55e;
  background: #dcfce7;
}

.setting-arrow {
  font-size: 18px;
  color: #d1d5db;
}

.picker-value {
  font-size: 14px;
  color: #3b82f6;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 24px;
  color: #9ca3af;
  font-size: 12px;
}

.version-info text {
  display: block;
}

.version-info text:last-child {
  margin-top: 4px;
  opacity: 0.7;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  background: white;
  width: 100%;
  max-height: 85vh;
  border-radius: 20px 20px 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid #f3f4f6;
}

.modal-title {
  font-size: 17px;
  font-weight: 600;
  color: #1f2937;
}

.modal-close {
  font-size: 20px;
  color: #9ca3af;
  padding: 4px;
}

.modal-body {
  padding: 20px;
  max-height: 60vh;
  overflow-y: auto;
}

/* 表单样式 */
.form-group {
  margin-bottom: 20px;
}

.form-label {
  font-size: 14px;
  font-weight: 500;
  color: #374151;
  margin-bottom: 8px;
  display: block;
}

.form-input {
  width: 100%;
  height: 44px;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 14px;
  box-sizing: border-box;
}

.form-hint {
  font-size: 12px;
  color: #9ca3af;
  margin-top: 6px;
  display: block;
}

.form-actions {
  display: flex;
  gap: 12px;
  margin-top: 24px;
}

.form-actions button {
  flex: 1;
}

.btn-primary {
  background: #3b82f6;
  color: white;
  border: none;
  border-radius: 8px;
  padding: 12px;
  font-size: 14px;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background: white;
  color: #6b7280;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 12px;
  font-size: 14px;
}

.btn-outline::after {
  border: none;
}

/* 数据管理 */
.data-info {
  text-align: center;
  margin-bottom: 24px;
}

.data-size {
  font-size: 32px;
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 8px;
}

.data-desc {
  font-size: 13px;
  color: #9ca3af;
}

.data-actions {
  display: flex;
  gap: 12px;
}

.data-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 16px;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.data-action:active {
  background: #f3f4f6;
}

.action-icon {
  font-size: 32px;
  margin-bottom: 12px;
}

.action-info {
  text-align: center;
}

.action-name {
  font-size: 14px;
  font-weight: 500;
  color: #1f2937;
  display: block;
  margin-bottom: 4px;
}

.action-desc {
  font-size: 12px;
  color: #9ca3af;
}
