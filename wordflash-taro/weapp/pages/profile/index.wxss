.profile-page{background:#f5f5f5;min-height:100vh;padding-bottom:120rpx}.section{background:#fff;border-radius:16rpx;margin:16rpx 24rpx;overflow:hidden}.section-header{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;padding:24rpx;position:relative}.section-icon{font-size:32rpx;margin-right:12rpx}.section-title{color:#333;-webkit-flex:1;-ms-flex:1;flex:1;font-size:30rpx;font-weight:600}.section-arrow{color:#ccc;font-size:32rpx;-webkit-transition:-webkit-transform .2s;transition:-webkit-transform .2s;transition:transform .2s;transition:transform .2s,-webkit-transform .2s}.section-arrow.open{-webkit-transform:rotate(90deg);-ms-transform:rotate(90deg);transform:rotate(90deg)}.ai-status-card{padding:0 24rpx 24rpx}.ai-status-row{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;gap:12rpx;margin-bottom:12rpx}.ai-status-dot{font-size:28rpx}.ai-status-text{color:#333;font-size:28rpx;font-weight:500}.ai-status-hint{background:#f0f9ff;border-radius:10rpx;color:#999;display:block;font-size:22rpx;line-height:1.5;padding:16rpx 20rpx}.stats-grid{display:-webkit-flex;display:-ms-flexbox;display:flex;gap:16rpx;padding:0 24rpx 24rpx}.stat-card{-webkit-align-items:center;background:#f9fafb;border-radius:12rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex:1;-ms-flex:1;flex:1;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;padding:20rpx;-ms-flex-align:center;align-items:center}.stat-number{color:#3b82f6;font-size:40rpx;font-weight:700}.stat-desc{color:#999;font-size:22rpx;margin-top:4rpx}.data-actions{padding:0 24rpx 24rpx}.data-btn{background:#f9fafb;border-radius:12rpx;margin-bottom:12rpx;padding:20rpx;text-align:center}.data-btn.danger{background:#fee2e2}.data-btn-text{color:#333;font-size:26rpx}.danger .data-btn-text{color:#dc2626}.about-section{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-ms-flex-align:center;align-items:center;padding:40rpx 0}.about-text{color:#999;font-size:26rpx}.about-subtext{color:#ccc;font-size:22rpx;margin-top:8rpx}