# WordFlash 环境变量配置

# 应用配置（必填）
APP_ID=wordflash
APP_SECRET=your-random-secret-here
DATABASE_URL=sqlite:./data/wordflash.db

# AI API 配置（必填 - 阿里云通义千问）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-your-api-key-here
AI_MODEL=qwen-turbo

# 加密密钥密码（本地开发用，部署到 Railway 时不需要）
# SECRET_PASSWORD=your-password
